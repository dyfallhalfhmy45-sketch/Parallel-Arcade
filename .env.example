# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PARALLEL_TOKEN=replace-with-a-random-token-at-least-24-characters
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_ISO_BYTES=8589934592
# Optional native Linux WebRTC mode (see README):
# DISPLAY_SOURCE=:99.0
# VIDEO_SIZE=1280x720
# OCR_CROP_TOP=0.55
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=
# Admin-configured IoT webhook. Never supplied by browser clients.
# IOT_WEBHOOK_URL=http://your-local-automation-server/webhook/parallel
# IOT_WEBHOOK_TOKEN=
